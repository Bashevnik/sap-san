# SAP SAN — приклад змінних середовища
#
# Цей репозиторій (sap-san) — статичний сайт (HTML/CSS/vanilla JS),
# який деплоїться на GitHub Pages через .github/workflows/pages.yml
# (простий rsync файлів, без збірки й без Node-рантайму на сервері).
# Тут НЕМАЄ жодного серверного/serverless-коду, тому process.env
# у цьому репозиторії наразі нічого не читає — файл нижче лише
# документує, де реально мають жити секрети проєкту.
#
# Не заповнюйте цей файл реальними значеннями. Скопіюйте як .env
# лише якщо колись додасте сюди власний серверний код (наприклад,
# proxy-функцію для Redis, описану в SECURITY.md).

# --- Upstash Redis (бот-адмінка) ------------------------------
# Ці два значення НЕ належать цьому репозиторію. Вони мають бути
# змінними середовища в окремому Vercel-проєкті бота
# (sapsanbot.vercel.app, сервер /api/content), а не тут і не в
# клієнтському js/config.js. Токен уже засвітився публічно —
# дивіться SECURITY.md, розділ «Що зробити прямо зараз».
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
